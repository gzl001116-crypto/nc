PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
# 与青澜支付站约定的验签密钥。演示默认值只适合本机。
QINGLAN_SHARED_SECRET=dev-qinglan-secret-change-me
# 留空则使用本进程里的青澜演示收银台。
QINGLAN_BASE_URL=
# 平台分成，万分比。2000 表示 20%。
PLATFORM_FEE_BPS=2000
DATA_DIR=data
# 配置 SMTP 后，验证码只发邮件，不再写入开发信箱。
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=NCstar <noreply@example.com>
